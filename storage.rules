rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // patients/{pid}/reminders/{rid}/... — Step 5 will populate full rules
    match /patients/{patientId}/reminders/{reminderId}/{allPaths=**} {
      // Only authenticated users can read (linked patient/caregivers — enforced via app layer for now)
      allow read: if request.auth != null;
      // Only authenticated users can write (full enforcement in Step 5)
      allow write: if request.auth != null &&
        request.resource.size < 2 * 1024 * 1024 && // 2 MB max
        request.resource.contentType.matches('image/.*');
    }
  }
}
