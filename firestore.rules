rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Allow read if user is authenticated (needed to search/verify profiles during linking)
      allow read: if request.auth != null;
      
      allow create: if request.auth != null && request.auth.uid == userId;
      
      allow update: if request.auth != null && (
        // Owner can update their own document
        request.auth.uid == userId ||
        // A caregiver can link themselves to a patient if the patient is not yet linked
        (request.resource.data.linkedCaregiverId == request.auth.uid && 
         resource.data.linkedCaregiverId == null &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedCaregiverId']))
      );
      
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /reminders/{reminderId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.patientId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == resource.data.patientId
      );
      
      allow create: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == request.resource.data.patientId &&
        request.resource.data.patientId is string &&
        request.resource.data.description is string && request.resource.data.description.size() > 0 &&
        request.resource.data.reminderType in ['Medication', 'Routine', 'Appointment'] &&
        request.resource.data.scheduledTime is timestamp &&
        request.resource.data.severityLevel in ['Low', 'Medium', 'High', 'Critical'] &&
        request.resource.data.escalationWaitingDuration is int &&
        request.resource.data.activeStatus is bool &&
        request.resource.data.snoozeEnabled is bool;

      allow update: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == resource.data.patientId &&
        request.resource.data.patientId == resource.data.patientId &&
        request.resource.data.description is string && request.resource.data.description.size() > 0 &&
        request.resource.data.reminderType in ['Medication', 'Routine', 'Appointment'] &&
        request.resource.data.scheduledTime is timestamp &&
        request.resource.data.severityLevel in ['Low', 'Medium', 'High', 'Critical'] &&
        request.resource.data.escalationWaitingDuration is int &&
        request.resource.data.activeStatus is bool &&
        request.resource.data.snoozeEnabled is bool;

      allow delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == resource.data.patientId;
    }

    match /reminderLogs/{logId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.patientId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == resource.data.patientId
      );
      
      allow create: if request.auth != null && (
        // Patient creating their own log
        (request.auth.uid == request.resource.data.patientId) ||
        // Caregiver creating log for their linked patient
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == request.resource.data.patientId)
      ) &&
      request.resource.data.patientId is string &&
      request.resource.data.reminderId is string &&
      request.resource.data.description is string && request.resource.data.description.size() > 0 &&
      request.resource.data.reminderType in ['Medication', 'Routine', 'Appointment'] &&
      request.resource.data.scheduledTime is timestamp &&
      request.resource.data.status in ['Triggered', 'Completed', 'Missed', 'Snoozed', 'Confirmed'] &&
      request.resource.data.actionTime is timestamp &&
      request.resource.data.escalationNotified is bool &&
      request.resource.data.snoozeEnabled is bool &&
      (!('completedAt' in request.resource.data) || request.resource.data.completedAt == null || request.resource.data.completedAt is timestamp);

      allow update: if request.auth != null && (
        // Patient updating their own log
        (request.auth.uid == resource.data.patientId && request.auth.uid == request.resource.data.patientId) ||
        // Caregiver updating log for their linked patient
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == resource.data.patientId &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == request.resource.data.patientId)
      ) &&
      request.resource.data.status in ['Triggered', 'Completed', 'Missed', 'Snoozed', 'Confirmed'] &&
      request.resource.data.actionTime is timestamp &&
      request.resource.data.escalationNotified is bool &&
      request.resource.data.patientId == resource.data.patientId &&
      request.resource.data.reminderId == resource.data.reminderId &&
      request.resource.data.description == resource.data.description &&
      request.resource.data.reminderType == resource.data.reminderType &&
      request.resource.data.scheduledTime == resource.data.scheduledTime &&
      request.resource.data.snoozeEnabled == resource.data.snoozeEnabled &&
      (!('completedAt' in request.resource.data) || request.resource.data.completedAt == null || request.resource.data.completedAt is timestamp);

      allow delete: if false;
    }
  }
}
