rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Allow read if user is authenticated and either:
      // 1. Reading their own document
      // 2. Reading their linked patient/caregiver document
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        resource.data.linkedPatientId == request.auth.uid ||
        resource.data.linkedCaregiverId == request.auth.uid
      );
      
      // Allow write (create, update, delete) only by the owner.
      // Note: Caregiver-Patient linking is done via Cloud Functions using the Admin SDK,
      // which bypasses security rules.
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
