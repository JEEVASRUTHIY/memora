rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Allow read if user is authenticated and is either the owner or linked to the owner
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        resource.data.linkedPatientId == request.auth.uid ||
        resource.data.linkedCaregiverId == request.auth.uid
      );
      
      allow create: if request.auth != null && request.auth.uid == userId;
      
      allow update: if request.auth != null && (
        // Owner can update their own document, but NOT role, linkedPatientId, or linkedCaregiverId once set
        (request.auth.uid == userId && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) &&
         (
           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['linkedPatientId', 'linkedCaregiverId']) ||
           (resource.data.linkedPatientId == null && request.resource.data.linkedPatientId is string) ||
           (resource.data.linkedCaregiverId == null && request.resource.data.linkedCaregiverId is string)
         )) ||
        // A caregiver can link themselves to a patient if the patient is not yet linked
        (request.resource.data.linkedCaregiverId == request.auth.uid && 
         resource.data.linkedCaregiverId == null &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedCaregiverId']))
      );
      
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /reminders/{reminderId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.patientId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == resource.data.patientId
      );
      
      allow create: if request.auth != null && 
        (request.auth.uid == request.resource.data.patientId ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == request.resource.data.patientId) &&
        request.resource.data.patientId is string &&
        request.resource.data.description is string && request.resource.data.description.size() > 0 &&
        request.resource.data.reminderType in ['Medication', 'Routine', 'Appointment'] &&
        request.resource.data.scheduledTime is timestamp &&
        request.resource.data.severityLevel in ['Low', 'Medium', 'High', 'Critical'] &&
        request.resource.data.escalationWaitingDuration is int &&
        request.resource.data.activeStatus is bool &&
        request.resource.data.snoozeEnabled is bool;

      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.patientId ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == resource.data.patientId) &&
        request.resource.data.patientId == resource.data.patientId &&
        request.resource.data.description is string && request.resource.data.description.size() > 0 &&
        request.resource.data.reminderType in ['Medication', 'Routine', 'Appointment'] &&
        request.resource.data.scheduledTime is timestamp &&
        request.resource.data.severityLevel in ['Low', 'Medium', 'High', 'Critical'] &&
        request.resource.data.activeStatus is bool &&
        request.resource.data.snoozeEnabled is bool;

      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.patientId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == resource.data.patientId
      );
    }

    match /reminderLogs/{logId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.patientId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == resource.data.patientId
      );
      
      allow create: if request.auth != null && (
        // Patient creating their own log
        (request.auth.uid == request.resource.data.patientId) ||
        // Caregiver creating log for their linked patient
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == request.resource.data.patientId)
      ) &&
      request.resource.data.patientId is string &&
      request.resource.data.reminderId is string &&
      request.resource.data.description is string && request.resource.data.description.size() > 0 &&
      request.resource.data.reminderType in ['Medication', 'Routine', 'Appointment'] &&
      request.resource.data.scheduledTime is timestamp &&
      request.resource.data.status in ['Triggered', 'Completed', 'Missed', 'Snoozed', 'Confirmed'] &&
      request.resource.data.actionTime is timestamp &&
      request.resource.data.escalationNotified is bool &&
      request.resource.data.snoozeEnabled is bool &&
      (!('completedAt' in request.resource.data) || request.resource.data.completedAt == null || request.resource.data.completedAt is timestamp);

      allow update: if request.auth != null && (
        // Patient updating their own log
        (request.auth.uid == resource.data.patientId && request.auth.uid == request.resource.data.patientId) ||
        // Caregiver updating log for their linked patient
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == resource.data.patientId &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == request.resource.data.patientId)
      ) &&
      request.resource.data.status in ['Triggered', 'Completed', 'Missed', 'Snoozed', 'Confirmed'] &&
      request.resource.data.actionTime is timestamp &&
      request.resource.data.escalationNotified is bool &&
      request.resource.data.patientId == resource.data.patientId &&
      request.resource.data.reminderId == resource.data.reminderId &&
      request.resource.data.description == resource.data.description &&
      request.resource.data.reminderType == resource.data.reminderType &&
      request.resource.data.scheduledTime == resource.data.scheduledTime &&
      request.resource.data.snoozeEnabled == resource.data.snoozeEnabled &&
      (!('completedAt' in request.resource.data) || request.resource.data.completedAt == null || request.resource.data.completedAt is timestamp);

      allow delete: if false;
    }

    match /safeZones/{patientId} {
      allow read: if request.auth != null && (
        request.auth.uid == patientId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == patientId
      );
      
      allow create, update: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == patientId &&
        request.resource.data.patientId == patientId &&
        request.resource.data.homeLatitude is number &&
        request.resource.data.homeLongitude is number &&
        request.resource.data.radius is number &&
        request.resource.data.radius > 0 &&
        request.resource.data.activeStatus is bool;

      allow delete: if false;
    }

    match /locationLogs/{logId} {
      allow read: if request.auth != null && (
        resource.data.patientId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == resource.data.patientId
      );
      
      allow create: if request.auth != null && 
        request.resource.data.patientId == request.auth.uid &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Patient' &&
        request.resource.data.status in ['Inside', 'Outside'] &&
        request.resource.data.timestamp is timestamp;
      
      allow update, delete: if false;
    }

    match /alerts/{alertId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.patientId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == resource.data.patientId
      );
      
      allow create: if request.auth != null && (
        // Patient creating their own alert
        (request.auth.uid == request.resource.data.patientId) ||
        // Caregiver creating alert for their linked patient
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == request.resource.data.patientId)
      ) &&
      request.resource.data.patientId is string &&
      request.resource.data.eventType in ['Missed Reminder', 'Safe Zone Breach', 'Behavioral Risk'] &&
      request.resource.data.severity in ['Low', 'Medium', 'High', 'Critical'] &&
      request.resource.data.alertTimestamp is timestamp &&
      request.resource.data.escalationLevel in ['Level 1', 'Level 2', 'Level 3', 'Level 4'] &&
      request.resource.data.notificationStatus is string &&
      request.resource.data.resolved is bool;

      allow update: if request.auth != null && (
        // Patient updating their own alert
        (request.auth.uid == resource.data.patientId && request.auth.uid == request.resource.data.patientId) ||
        // Caregiver updating alert for their linked patient
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == resource.data.patientId &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == resource.data.patientId)
      ) &&
      request.resource.data.resolved is bool &&
      request.resource.data.escalationLevel in ['Level 1', 'Level 2', 'Level 3', 'Level 4'] &&
      request.resource.data.patientId == resource.data.patientId &&
      request.resource.data.eventType == resource.data.eventType &&
      request.resource.data.severity == resource.data.severity &&
      request.resource.data.alertTimestamp == resource.data.alertTimestamp;

      allow delete: if false;
    }

    match /dailyBehavior/{docId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.patientId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == resource.data.patientId
      );
      
      allow create: if request.auth != null && (
        // Patient creating their own behavioral entry
        (request.auth.uid == request.resource.data.patientId) ||
        // Caregiver creating entry for their linked patient
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == request.resource.data.patientId)
      ) &&
      request.resource.data.patientId is string &&
      request.resource.data.date is string &&
      request.resource.data.hydrationAdherencePercentage is number &&
      request.resource.data.medicationAdherencePercentage is number &&
      (request.resource.data.activityLevel is number || request.resource.data.activityLevel is string) &&
      request.resource.data.safeZoneExits is int &&
      request.resource.data.missedReminders is int &&
      request.resource.data.stabilityScore is number &&
      request.resource.data.riskClassification in ['Stable', 'Moderate Risk', 'High Risk'];

      allow update: if request.auth != null && (
        // Patient updating their own entry
        (request.auth.uid == resource.data.patientId && request.auth.uid == request.resource.data.patientId) ||
        // Caregiver updating entry for their linked patient
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == resource.data.patientId &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == request.resource.data.patientId)
      ) &&
      request.resource.data.patientId == resource.data.patientId &&
      request.resource.data.date == resource.data.date;

      allow delete: if false;
    }

    match /weeklySummaries/{summaryId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.patientId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == resource.data.patientId
      );
      
      allow create, update: if request.auth != null && (
        // Patient creating their own summary
        (request.auth.uid == request.resource.data.patientId) ||
        // Caregiver creating summary for their linked patient
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPatientId == request.resource.data.patientId)
      ) &&
      request.resource.data.patientId is string &&
      request.resource.data.weekId is string &&
      request.resource.data.averageStabilityScore is number &&
      request.resource.data.hydrationAdherencePercentage is number &&
      request.resource.data.medicationAdherencePercentage is number &&
      request.resource.data.alertCount is number &&
      request.resource.data.safeZoneExits is number &&
      request.resource.data.weeklySummaryText is string &&
      request.resource.data.insightCards is list &&
      request.resource.data.timestamp is timestamp;

      allow delete: if false;
    }

    match /guidanceKnowledge/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
